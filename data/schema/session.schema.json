{
  "$defs": {
    "Availability": {
      "enum": [
        "open",
        "waitlist",
        "full",
        "unknown"
      ],
      "title": "Availability",
      "type": "string"
    },
    "Method": {
      "enum": [
        "manual",
        "blackpug",
        "doubleknot",
        "llm_extraction",
        "community"
      ],
      "title": "Method",
      "type": "string"
    },
    "ProgramType": {
      "enum": [
        "scouts_bsa_resident",
        "cub_resident",
        "cub_day",
        "high_adventure",
        "webelos"
      ],
      "title": "ProgramType",
      "type": "string"
    },
    "Provenance": {
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "verified_at": {
          "format": "date",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "method",
        "verified_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "properties": {
    "availability": {
      "$ref": "#/$defs/Availability",
      "default": "unknown"
    },
    "camp_id": {
      "title": "Camp Id",
      "type": "string"
    },
    "end_date": {
      "format": "date",
      "title": "End Date",
      "type": "string"
    },
    "fee_adult": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fee Adult"
    },
    "fee_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fee Notes"
    },
    "fee_youth": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fee Youth"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "program_type": {
      "$ref": "#/$defs/ProgramType",
      "default": "scouts_bsa_resident"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "registration_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registration Url"
    },
    "start_date": {
      "format": "date",
      "title": "Start Date",
      "type": "string"
    },
    "year": {
      "maximum": 2100,
      "minimum": 2024,
      "title": "Year",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "camp_id",
    "year",
    "start_date",
    "end_date",
    "provenance"
  ],
  "title": "Session",
  "type": "object"
}
