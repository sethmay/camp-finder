{
  "$defs": {
    "Availability": {
      "enum": [
        "open",
        "waitlist",
        "full",
        "unknown"
      ],
      "title": "Availability",
      "type": "string"
    },
    "Camp": {
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "council_id": {
          "title": "Council Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/Feature"
          },
          "title": "Features",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "program_types": {
          "items": {
            "$ref": "#/$defs/ProgramType"
          },
          "title": "Program Types",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/Session"
          },
          "title": "Sessions",
          "type": "array"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CampStatus",
          "default": "active"
        },
        "website_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Website Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "council_id",
        "state",
        "website_url",
        "provenance"
      ],
      "title": "Camp",
      "type": "object"
    },
    "CampStatus": {
      "enum": [
        "active",
        "not_operating",
        "closed"
      ],
      "title": "CampStatus",
      "type": "string"
    },
    "Feature": {
      "enum": [
        "dining_hall",
        "waterfront",
        "pool",
        "shooting_sports",
        "climbing",
        "horseback",
        "atv",
        "cope",
        "older_scout_program",
        "high_adventure_option",
        "stem",
        "scuba",
        "mountain_biking"
      ],
      "title": "Feature",
      "type": "string"
    },
    "Method": {
      "enum": [
        "manual",
        "blackpug",
        "doubleknot",
        "llm_extraction",
        "community"
      ],
      "title": "Method",
      "type": "string"
    },
    "Platform": {
      "enum": [
        "blackpug",
        "doubleknot",
        "tentaroo",
        "other",
        "unknown"
      ],
      "title": "Platform",
      "type": "string"
    },
    "ProgramType": {
      "enum": [
        "scouts_bsa_resident",
        "cub_resident",
        "cub_day",
        "high_adventure",
        "webelos"
      ],
      "title": "ProgramType",
      "type": "string"
    },
    "Provenance": {
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "verified_at": {
          "format": "date",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "method",
        "verified_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Session": {
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability",
          "default": "unknown"
        },
        "camp_id": {
          "title": "Camp Id",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "fee_adult": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee Adult"
        },
        "fee_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee Notes"
        },
        "fee_youth": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee Youth"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "program_type": {
          "$ref": "#/$defs/ProgramType",
          "default": "scouts_bsa_resident"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "registration_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registration Url"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "year": {
          "maximum": 2100,
          "minimum": 2024,
          "title": "Year",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "camp_id",
        "year",
        "start_date",
        "end_date",
        "provenance"
      ],
      "title": "Session",
      "type": "object"
    }
  },
  "properties": {
    "camps": {
      "items": {
        "$ref": "#/$defs/Camp"
      },
      "title": "Camps",
      "type": "array"
    },
    "hq_city": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hq City"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Number"
    },
    "platform": {
      "$ref": "#/$defs/Platform",
      "default": "unknown"
    },
    "state": {
      "title": "State",
      "type": "string"
    },
    "website": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Website"
    }
  },
  "required": [
    "id",
    "name",
    "state"
  ],
  "title": "Council",
  "type": "object"
}
