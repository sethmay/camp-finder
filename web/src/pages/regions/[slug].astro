---
import Base from "../../layouts/Base.astro";
import CampCard from "../../components/CampCard";
import { Heading } from "@opensourcescouting/design-system";
import { withBase } from "@lib/paths";
import type { Camp } from "@lib/types";
import { REGIONS, regionSlug, stateName, stateSlug } from "@lib/region";
import { campsByRegion, statesInRegion } from "@lib/collections";
import campsData from "../../../public/data/camps.json";

export function getStaticPaths() {
  const camps = campsData as unknown as Camp[];
  const byRegion = campsByRegion(camps);
  const statesBy = statesInRegion(camps);
  return REGIONS.map((region) => ({
    params: { slug: regionSlug(region) },
    props: { region, camps: byRegion.get(region) ?? [], states: statesBy.get(region) ?? [] },
  }));
}

const { region, camps, states } = Astro.props as { region: string; camps: Camp[]; states: string[] };
const url = `https://scoutcamps.org/regions/${regionSlug(region)}/`;
const title = `Scouts BSA Summer Camps in the ${region} — Camp Finder`;
const description = `Browse ${camps.length} Scouts BSA summer camps across ${states.length} states in the ${region} region. Each links to the council's official page for dates and fees.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: `Scouts BSA Summer Camps in the ${region}`,
      description,
      url,
      mainEntity: {
        "@type": "ItemList",
        numberOfItems: camps.length,
        itemListElement: camps.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: `https://scoutcamps.org/camps/${c.id}/`,
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://scoutcamps.org/" },
        { "@type": "ListItem", position: 2, name: "Regions", item: "https://scoutcamps.org/regions/" },
        { "@type": "ListItem", position: 3, name: region, item: url },
      ],
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd} ogImage={`/og/regions/${regionSlug(region)}.png`}>
  <article class="mx-auto max-w-[1280px] px-4 py-8">
    <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a href={withBase("/")} class="text-primary hover:text-primary/90">Home</a>
      <span class="px-1.5" aria-hidden="true">/</span>
      <a href={withBase("/regions")} class="text-primary hover:text-primary/90">Regions</a>
      <span class="px-1.5" aria-hidden="true">/</span>
      <span>{region}</span>
    </nav>

    <Heading level={1} size={2} className="mt-4">Scouts BSA Summer Camps in the {region}</Heading>
    <p class="mt-2 max-w-2xl text-base text-muted-foreground">{description}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {
        states.map((code) => (
          <a
            href={withBase(`/states/${stateSlug(code)}`)}
            class="cf-tap inline-flex items-center rounded-full border border-border bg-card px-3 text-sm text-foreground hover:border-primary"
          >
            {stateName(code)}
          </a>
        ))
      }
    </div>

    <ul class="mt-6 grid gap-3 md:grid-cols-2">
      {
        camps.map((camp) => (
          <li>
            <CampCard ranked={{ camp, distanceMiles: null }} />
          </li>
        ))
      }
    </ul>
  </article>
</Base>
