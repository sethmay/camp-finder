---
import Base from "../../../layouts/Base.astro";
import PreCampChecklist from "../../../components/PreCampChecklist";
import { Heading } from "@opensourcescouting/design-system";
import { withBase } from "@lib/paths";
import type { Camp } from "@lib/types";
import { buildChecklist } from "@lib/checklist";
import campsData from "../../../../public/data/camps.json";

export function getStaticPaths() {
  const camps = campsData as unknown as Camp[];
  return camps.map((camp) => ({ params: { id: camp.id }, props: { camp } }));
}

const { camp } = Astro.props as { camp: Camp };
const sections = buildChecklist(camp);
const title = `Pre-camp checklist · ${camp.name} — Camp Finder`;
const description = `A packing and preparation checklist for ${camp.name}, tailored to its programs. Check items off and print; confirm the details on the council's official page.`;
---

<Base title={title} description={description} ogImage={`/og/${camp.id}.png`} noindex>
  <article class="mx-auto max-w-3xl px-4 py-8">
    <a href={withBase(`/camps/${camp.id}`)} class="text-sm text-primary hover:text-primary/90 print:hidden">
      &larr; {camp.name}
    </a>
    <Heading level={1} size={2} className="mt-4">Pre-camp checklist</Heading>
    <p class="mt-1 text-base text-muted-foreground">{camp.name}</p>

    <div class="mt-6">
      <PreCampChecklist
        client:load
        sections={sections}
        campId={camp.id}
        campName={camp.name}
        campUrl={camp.url}
      />
    </div>
  </article>
</Base>
