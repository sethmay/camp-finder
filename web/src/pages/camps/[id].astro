---
import Base from "../../layouts/Base.astro";
import FeatureChip from "../../components/FeatureChip";
import ProvenanceBadge from "../../components/ProvenanceBadge";
import StaleBadge from "../../components/StaleBadge";
import CampLocationMap from "../../components/CampLocationMap";
import { formatVerified, isStale, orderFeatures, programCategories, PROGRAM_CATEGORY_LABEL } from "../../lib/format";
import type { Camp } from "../../lib/types";
import { withBase } from "@lib/paths";
import { Alert, Badge, Card, CardBody, Heading, buttonVariants, cn } from "@opensourcescouting/design-system";
import campsData from "../../../public/data/camps.json";

export function getStaticPaths() {
  const camps = campsData as unknown as Camp[];
  return camps.map((camp) => ({ params: { id: camp.id }, props: { camp } }));
}

const { camp } = Astro.props as { camp: Camp };
const location = [camp.city, camp.state].filter(Boolean).join(", ") || "Location not listed";
const operator =
  camp.council_name ?? (camp.operator === "national" ? "National high-adventure base" : null);
const stale = isStale(camp.verified_at);
const badgeCats = programCategories(camp.program_types).filter((c) => c !== "scouts_bsa");
---

<Base title={`${camp.name} — Camp Finder`} description={camp.summary ?? undefined}>
  <article class="mx-auto max-w-3xl px-4 py-8">
    <a href={withBase("/")} class="text-sm text-primary">← Back to search</a>

    <header class="mt-4">
      <Heading level={1} size={2}>{camp.name}</Heading>
      {
        badgeCats.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-1">
            {badgeCats.map((c) => (
              <Badge variant="outline">{PROGRAM_CATEGORY_LABEL[c]}</Badge>
            ))}
          </div>
        )
      }
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_minmax(0,340px)] lg:items-start">
        <div>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <p class="text-base text-muted-foreground">
              {operator ? `${operator} · ${location}` : location}
            </p>
            <StaleBadge verifiedAt={camp.verified_at} />
          </div>
          {
            camp.reservation?.name && (
              <p class="mt-1 text-sm text-muted-foreground">Part of {camp.reservation.name}</p>
            )
          }
          <a
            href={camp.url}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[buttonVariants({ variant: "primary", size: "md" }), "mt-4"]}
          >
            Visit official council page →
          </a>
        </div>
        {
          camp.lat != null && camp.lon != null && (
            <div class="h-64 overflow-hidden rounded-lg border border-input">
              <CampLocationMap client:visible lat={camp.lat} lon={camp.lon} name={camp.name} />
            </div>
          )
        }
      </div>
    </header>

    {
      stale && (
        <Alert tone="warning" className="mt-6">
          This listing hasn't been verified in over a year. Confirm all details on the
          official council page before registering.
        </Alert>
      )
    }

    {camp.summary && <p class="mt-6 text-base text-foreground">{camp.summary}</p>}

    {
      camp.july_high_f !== null && (
        <p class="mt-4 text-sm text-muted-foreground">
          Typical July: {camp.july_low_f !== null ? `${camp.july_low_f}–${camp.july_high_f}` : `${camp.july_high_f}`}°F avg — climate normals via Open Scout API
        </p>
      )
    }

    {
      camp.features.length > 0 && (
        <section class="mt-6">
          <Heading level={2} size={3}>Program &amp; features</Heading>
          {/* The pill bounds each feature, so the gap only has to separate outlines --
              back to a tight chip row from the wider spacing a containerless list needed. */}
          <div class="mt-3 flex flex-wrap gap-1.5">
            {orderFeatures(camp.features, camp.features_signature).map((f) => (
              <FeatureChip feature={f} signature={camp.features_signature.includes(f)} />
            ))}
          </div>
          {
            (camp.features_signature.length > 0 || camp.features_verified_at) && (
              <p class="mt-2 text-xs text-muted-foreground">
                {camp.features_signature.length > 0 && "★ signature feature. "}
                {camp.features_verified_at && `Features surveyed ${formatVerified(camp.features_verified_at)}.`}
              </p>
            )
          }
        </section>
      )
    }

    <Card variant="elevated" className="mt-8">
      <CardBody>
        <Heading level={2} size={3}>Sessions, dates &amp; fees</Heading>
        <p class="mt-2 text-sm text-muted-foreground">
          Session weeks, fees, and availability change often and live on the council's own
          site — always the authoritative source. Check there for the current schedule and
          to register.
        </p>
        {/* A DS ghost button needs h-auto/whitespace-normal to survive this long label in a
            narrow card (buttonVariants pins h-11 and whitespace-nowrap, and Card clips with
            overflow-hidden); -ml-5 cancels the button padding so it aligns with the copy. */}
        <a
          href={camp.url}
          target="_blank"
          rel="noopener noreferrer"
          class={cn(
            buttonVariants({ variant: "ghost", size: "md" }),
            "-ml-5 mt-1 h-auto min-h-11 whitespace-normal py-2",
          )}
        >
          Dates &amp; registration on the council site →
        </a>
      </CardBody>
    </Card>

    <Card variant="elevated" className="mt-8">
      <CardBody>
        {/* The flex column sits on a plain div, not on CardBody: Astro wraps a React
            component's slotted children in an <astro-static-slot> element, and the
            display:contents rule that neutralises it only ships on pages that have a
            hydrated island. Flexing CardBody itself would collapse to a single item. */}
        <div class="flex flex-col gap-4">
          {camp.council_website && (
            <a
              href={camp.council_website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-semibold text-primary"
            >
              {camp.council_name ?? "Council"} website →
            </a>
          )}
          <ProvenanceBadge sourceUrl={camp.url} verifiedAt={camp.verified_at} />
          <a href={withBase("/about#corrections")} class="text-xs text-muted-foreground underline">
            See a problem with this listing? Suggest a correction.
          </a>
        </div>
      </CardBody>
    </Card>
  </article>
</Base>
