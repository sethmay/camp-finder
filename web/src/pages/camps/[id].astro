---
import Base from "../../layouts/Base.astro";
import FeatureChip from "../../components/FeatureChip";
import ProvenanceBadge from "../../components/ProvenanceBadge";
import StaleBadge from "../../components/StaleBadge";
import CampLocationMap from "../../components/CampLocationMap";
import { isStale, programCategories, PROGRAM_CATEGORY_LABEL } from "../../lib/format";
import type { Camp } from "../../lib/types";
import { withBase } from "@lib/paths";
import campsData from "../../../public/data/camps.json";

export function getStaticPaths() {
  const camps = campsData as unknown as Camp[];
  return camps.map((camp) => ({ params: { id: camp.id }, props: { camp } }));
}

const { camp } = Astro.props as { camp: Camp };
const location = [camp.city, camp.state].filter(Boolean).join(", ") || "Location not listed";
const operator =
  camp.council_name ?? (camp.operator === "national" ? "National high-adventure base" : null);
const stale = isStale(camp.verified_at);
const badgeCats = programCategories(camp.program_types).filter((c) => c !== "scouts_bsa");
---

<Base title={`${camp.name} — Camp Finder`} description={camp.summary ?? undefined}>
  <article class="mx-auto max-w-3xl px-4 py-8">
    <a href={withBase("/")} class="text-sm text-primary">← Back to search</a>

    <header class="mt-4">
      <h1 class="font-display text-h1 text-ink">{camp.name}</h1>
      {
        badgeCats.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-1">
            {badgeCats.map((c) => (
              <span class="inline-flex items-center rounded-pill border border-primary px-2 py-0.5 text-xs font-semibold text-primary">
                {PROGRAM_CATEGORY_LABEL[c]}
              </span>
            ))}
          </div>
        )
      }
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_minmax(0,340px)] lg:items-start">
        <div>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <p class="text-body text-muted">
              {operator ? `${operator} · ${location}` : location}
            </p>
            <StaleBadge verifiedAt={camp.verified_at} />
          </div>
          {
            camp.reservation?.name && (
              <p class="mt-1 text-sm text-muted">Part of {camp.reservation.name}</p>
            )
          }
          <a
            href={camp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="cf-tap mt-4 inline-flex items-center justify-center rounded-md bg-primary px-6 font-semibold text-surface hover:bg-primary-700"
          >
            Visit official council page →
          </a>
        </div>
        {
          camp.lat != null && camp.lon != null && (
            <div class="h-64 overflow-hidden rounded-md border border-border">
              <CampLocationMap client:visible lat={camp.lat} lon={camp.lon} name={camp.name} />
            </div>
          )
        }
      </div>
    </header>

    {
      stale && (
        <p class="mt-6 rounded-md bg-waitlist-bg px-4 py-3 text-sm text-waitlist-ink">
          This listing hasn't been verified in over a year. Confirm all details on the
          official council page before registering.
        </p>
      )
    }

    {camp.summary && <p class="mt-6 text-body text-ink">{camp.summary}</p>}

    {
      camp.july_high_f !== null && (
        <p class="mt-4 text-sm text-muted">
          Typical July: {camp.july_low_f !== null ? `${camp.july_low_f}–${camp.july_high_f}` : `${camp.july_high_f}`}°F avg — climate normals via Open Scout API
        </p>
      )
    }

    {
      camp.features.length > 0 && (
        <section class="mt-6">
          <h2 class="font-display text-h3 text-ink">Program &amp; features</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {camp.features.map((f) => <FeatureChip feature={f} />)}
          </div>
        </section>
      )
    }

    <section class="mt-8 rounded-md border border-border bg-surface p-4">
      <h2 class="font-display text-h3 text-ink">Sessions, dates &amp; fees</h2>
      <p class="mt-2 text-sm text-muted">
        Session weeks, fees, and availability change often and live on the council's own
        site — always the authoritative source. Check there for the current schedule and
        to register.
      </p>
      <a
        href={camp.url}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primary"
      >
        Dates &amp; registration on the council site →
      </a>
    </section>

    <div class="mt-8 flex flex-col gap-4 rounded-md border border-border bg-surface p-4">
      {camp.council_website && (
        <a
          href={camp.council_website}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-primary"
        >
          {camp.council_name ?? "Council"} website →
        </a>
      )}
      <ProvenanceBadge sourceUrl={camp.url} verifiedAt={camp.verified_at} />
      <a href={withBase("/about#corrections")} class="text-xs text-muted underline">
        See a problem with this listing? Suggest a correction.
      </a>
    </div>
  </article>
</Base>
