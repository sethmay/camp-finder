---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — Camp Finder">
  <div class="mx-auto max-w-md px-4 py-20 text-center">
    <p class="font-display text-display text-primary">404</p>
    <h1 class="mt-2 font-display text-h2 text-ink">We couldn't find that page</h1>
    <p class="mt-2 text-body text-muted">
      The camp or page you're looking for may have moved.
    </p>
    <a
      href="/"
      class="cf-tap mt-6 inline-flex items-center justify-center rounded-md bg-primary px-6 font-semibold text-surface hover:bg-primary-700"
    >
      Back to search
    </a>
  </div>
</Base>
