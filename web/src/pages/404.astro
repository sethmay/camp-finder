---
import Base from "../layouts/Base.astro";
import { withBase } from "@lib/paths";
import { buttonVariants, Heading } from "@opensourcescouting/design-system";
---

<Base title="Not found — Camp Finder">
  <div class="mx-auto max-w-md px-4 py-20 text-center">
    <!-- Decorative status numeral, not a heading: the h1 below carries the page title. -->
    <p class="display text-4xl sm:text-5xl md:text-6xl text-primary">404</p>
    <Heading level={1} size={3} className="mt-2">We couldn't find that page</Heading>
    <p class="mt-2 text-base text-muted-foreground">
      The camp or page you're looking for may have moved.
    </p>
    <a href={withBase("/")} class:list={[buttonVariants({ variant: "primary", size: "md" }), "mt-6"]}>
      Back to search
    </a>
  </div>
</Base>
