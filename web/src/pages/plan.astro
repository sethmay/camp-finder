---
import Base from "../layouts/Base.astro";
import CampPlanner from "../components/CampPlanner";
import { Heading } from "@opensourcescouting/design-system";
---

<Base
  title="Plan camp — Camp Finder"
  description="Plan and organize your troop's trip to summer camp: a planning timeline for fundraising, recruiting, and logistics, plus a packing list to share with families."
  noindex
>
  <section class="mx-auto max-w-3xl px-4 py-8">
    <Heading level={1} size={2}>Plan camp</Heading>
    <p class="mt-1 text-base text-muted-foreground print:hidden">
      Organize your troop's trip and check items off as you go. Saved on this device.
    </p>
    <div class="mt-6">
      <CampPlanner client:load />
    </div>
  </section>
</Base>
