---
import Base from "../../layouts/Base.astro";
import { Heading } from "@opensourcescouting/design-system";
import { withBase } from "@lib/paths";
import type { Camp } from "@lib/types";
import { REGIONS, regionSlug, stateName, stateSlug } from "@lib/region";
import { campsByState, statesInRegion } from "@lib/collections";
import campsData from "../../../public/data/camps.json";

const camps = campsData as unknown as Camp[];
const byState = campsByState(camps);
const statesBy = statesInRegion(camps);

// Groups shown on the hub: the four regions, then an "Overseas" catch-all for states with no
// US region (AE/AP) so every state page stays reachable and crawlable from here.
const regioned = new Set(REGIONS.flatMap((r) => statesBy.get(r) ?? []));
const overseas = [...byState.keys()]
  .filter((code) => !regioned.has(code))
  .sort((a, b) => stateName(a).localeCompare(stateName(b)));
const groups: { label: string; slug: string | null; codes: string[] }[] = [
  ...REGIONS.map((r) => ({ label: r, slug: regionSlug(r), codes: statesBy.get(r) ?? [] })),
  ...(overseas.length ? [{ label: "Overseas", slug: null, codes: overseas }] : []),
];

const title = "Browse Scouts BSA Summer Camps by State — Camp Finder";
const description = `Scouts BSA summer camps in ${byState.size} states and territories. Pick a state to see its camps, each linked to the council's official page.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://scoutcamps.org/" },
    { "@type": "ListItem", position: 2, name: "States", item: "https://scoutcamps.org/states/" },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-[1280px] px-4 py-8">
    <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a href={withBase("/")} class="text-primary hover:text-primary/90">Home</a>
      <span class="px-1.5" aria-hidden="true">/</span>
      <span>States</span>
    </nav>

    <Heading level={1} size={2} className="mt-4">Browse camps by state</Heading>
    <p class="mt-2 max-w-2xl text-base text-muted-foreground">{description}</p>

    <div class="mt-6 flex flex-col gap-6">
      {
        groups.map((g) => (
          <section>
            {g.slug ? (
              <a href={withBase(`/regions/${g.slug}`)} class="text-sm font-semibold uppercase tracking-wide text-primary hover:text-primary/90">
                {g.label}
              </a>
            ) : (
              <span class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">{g.label}</span>
            )}
            <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5">
              {g.codes.map((code) => (
                <li>
                  <a href={withBase(`/states/${stateSlug(code)}`)} class="text-base text-foreground hover:text-primary">
                    {stateName(code)}
                    <span class="text-sm text-muted-foreground"> ({(byState.get(code) ?? []).length})</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</Base>
