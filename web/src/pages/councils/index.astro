---
import Base from "../../layouts/Base.astro";
import { Heading } from "@opensourcescouting/design-system";
import { withBase } from "@lib/paths";
import type { Camp } from "@lib/types";
import { campsByCouncil } from "@lib/collections";
import campsData from "../../../public/data/camps.json";

interface CouncilRow {
  slug: string;
  name: string;
  count: number;
}

const camps = campsData as unknown as Camp[];
const byCouncil = campsByCouncil(camps);
const councils: CouncilRow[] = [...byCouncil]
  .map(([slug, cs]) => ({ slug, name: cs[0].council_name ?? slug, count: cs.length }))
  .sort((a, b) => a.name.localeCompare(b.name));

// Bucket by first letter so 200+ councils stay scannable.
const letters = new Map<string, CouncilRow[]>();
for (const c of councils) {
  const letter = c.name[0].toUpperCase();
  const bucket = letters.get(letter);
  if (bucket) bucket.push(c);
  else letters.set(letter, [c]);
}
const groups = [...letters].sort((a, b) => a[0].localeCompare(b[0]));

const title = "Browse Scouts BSA Summer Camps by Council — Camp Finder";
const description = `Scouts BSA summer camps from ${councils.length} local councils across the country. Pick a council to see its camps, each linked to the council's official page.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://scoutcamps.org/" },
    { "@type": "ListItem", position: 2, name: "Councils", item: "https://scoutcamps.org/councils/" },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-[1280px] px-4 py-8">
    <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a href={withBase("/")} class="text-primary hover:text-primary/90">Home</a>
      <span class="px-1.5" aria-hidden="true">/</span>
      <span>Councils</span>
    </nav>

    <Heading level={1} size={2} className="mt-4">Browse camps by council</Heading>
    <p class="mt-2 max-w-2xl text-base text-muted-foreground">{description}</p>

    <div class="mt-6 flex flex-col gap-6">
      {
        groups.map(([letter, rows]) => (
          <section>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-primary">{letter}</h2>
            <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5">
              {rows.map((c) => (
                <li>
                  <a href={withBase(`/councils/${c.slug}`)} class="text-base text-foreground hover:text-primary">
                    {c.name}
                    <span class="text-sm text-muted-foreground"> ({c.count})</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</Base>
