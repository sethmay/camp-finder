---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Camp Finder — discover Scouts BSA summer camps",
  description = "Find Scouts BSA resident summer camps across the country by location, program, and features. Links to each council's official page for dates and fees.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400..900&family=Public+Sans:wght@400..700&family=IBM+Plex+Mono:wght@400..600&display=swap"
    />
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
