---
import { withBase } from "@lib/paths";
// The disclaimer ships on every page (design non-negotiable + IMPLEMENTATION §13).
---

<footer class="mt-12 border-t border-border bg-surface">
  <div class="mx-auto max-w-[1280px] px-4 py-8 text-sm text-muted">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xl">
        <p class="font-display text-h3 text-ink">Camp Finder</p>
        <p class="mt-2">
          An unofficial, community-built directory of Scouts BSA resident summer camps.
          Every listing links to the council's official page — always confirm dates and
          fees there before registering.
        </p>
      </div>
      <nav class="flex flex-col gap-2" aria-label="Footer">
        <a class="hover:text-ink" href={withBase("/about")}>About &amp; methodology</a>
        <a class="hover:text-ink" href={withBase("/about#corrections")}>Suggest a correction</a>
      </nav>
    </div>
    <p class="mt-6 border-t border-border pt-4 text-xs">
      Not affiliated with, endorsed by, or sponsored by Scouting America (Boy Scouts of
      America). All council and camp names are the property of their respective owners.
    </p>
  </div>
</footer>
