---
import { withBase } from "@lib/paths";
import pkg from "../../package.json";
import metaData from "../../public/data/meta.json";
import type { Meta } from "@lib/types";
const meta = metaData as unknown as Meta;
// The disclaimer ships on every page (design non-negotiable + IMPLEMENTATION §13).
---

<footer class="mt-12 border-t border-border bg-card print:hidden">
  <div class="mx-auto max-w-[1280px] px-4 py-8 text-sm text-muted-foreground">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div class="max-w-xl">
        <p class="display text-xl sm:text-2xl text-foreground">Camp Finder</p>
        <p class="mt-2">
          An unofficial, community-built directory of Scouts BSA resident summer camps.
          Every listing links to the council's official page. Confirm dates and fees there
          before you register.
        </p>
        <p class="mt-2">Free and open source.</p>
      </div>
      <nav class="flex flex-col gap-2" aria-label="Footer">
        <a class="hover:text-foreground" href={withBase("/states")}>Browse camps by state</a>
        <a class="hover:text-foreground" href={withBase("/regions")}>Browse camps by region</a>
        <a class="hover:text-foreground" href={withBase("/councils")}>Browse camps by council</a>
        <a class="hover:text-foreground" href={withBase("/about")}>About &amp; methodology</a>
        <a class="hover:text-foreground" href={withBase("/about#corrections")}>Suggest a correction</a>
        <a class="hover:text-foreground" href="https://github.com/sethmay/camp-finder" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
      </nav>
    </div>
    <p class="mt-6 border-t border-border pt-4 text-xs">
      Not affiliated with, endorsed by, or sponsored by Scouting America (Boy Scouts of
      America). All council and camp names are the property of their respective owners.
    </p>
    <p class="mt-2 text-xs text-muted-foreground">
      Camp Finder v{pkg.version} · Open Scout API v{meta.source_version}
    </p>
  </div>
</footer>
