---
import { withBase } from "@lib/paths";
const path = Astro.url.pathname;
const links = [
  { href: withBase("/"), label: "Search" },
  { href: withBase("/about"), label: "About" },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-4 px-4 py-3">
    <a href={withBase("/")} class="flex items-center gap-2 font-display text-h3 font-extrabold text-ink">
      <!-- Trailhead tent glyph (design identity A) -->
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="none">
        <path d="M12 3 3 20h18L12 3Z" stroke="#1D5E42" stroke-width="2" stroke-linejoin="round" />
        <path d="M12 9 8.5 20M12 9l3.5 11" stroke="#B5551F" stroke-width="2" stroke-linecap="round" />
      </svg>
      Camp Finder
    </a>
    <nav class="flex items-center gap-1" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? "page" : undefined}
            class:list={[
              "cf-tap flex items-center rounded-sm px-3 text-sm font-semibold",
              path === l.href ? "text-primary" : "text-muted hover:text-ink",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
