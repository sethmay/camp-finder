---
import { withBase } from "@lib/paths";
const path = Astro.url.pathname;
const links = [
  { href: withBase("/"), label: "Search", hash: "#search", id: "nav-search" },
  { href: withBase("/compare"), label: "Compare" },
  { href: withBase("/plan"), label: "Plan" },
  { href: withBase("/about"), label: "About" },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-card/95 backdrop-blur print:hidden">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-4 px-4 py-3">
    <a href={withBase("/")} class="flex items-center gap-2 display text-xl sm:text-2xl text-foreground">
      <!-- Trailhead tent glyph (design identity A). Colour rides currentColor:
           the svg inherits text-primary, the accent path overrides to text-os-accent. -->
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="none" class="text-primary">
        <path d="M12 3 3 20h18L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path class="text-os-accent" d="M12 9 8.5 20M12 9l3.5 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      Camp Finder
    </a>
    <nav class="flex items-center gap-1" aria-label="Primary">
      {
        links.map((l) => (
          <a
            id={l.id}
            href={l.hash ? l.href + l.hash : l.href}
            data-home={l.hash ? l.href : undefined}
            aria-current={path === l.href ? "page" : undefined}
            class:list={[
              "cf-tap flex items-center rounded-lg px-3 display text-sm",
              path === l.href ? "text-primary" : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // "Search" focuses the name field (via a #search signal SearchApp listens for). When you're
  // already on the search page, set the hash directly instead of navigating — that preserves any
  // in-progress query (filters) and still fires the hashchange SearchApp reacts to.
  const link = document.getElementById("nav-search");
  if (link) {
    const home = link.dataset.home || "/";
    link.addEventListener("click", (e) => {
      if (window.location.pathname === home) {
        e.preventDefault();
        window.location.hash = "search";
      }
    });
  }
</script>
